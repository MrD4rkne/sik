socket me 8001
socket dup 8002
socket dup2 8003
host server 127.0.0.1 8000

# Hello
send me server B 1

# Expecting hello response with count 0
receive me server 1 BH 2,0

# Send hello from second address
send dup server B 1
# 127.0.0.1 = int(2130706433)
receive dup server 1 BHBIH 2,1,4,2130706433,8001

# Send hello from third address
send dup2 server B 1
# 127.0.0.1 = int(2130706433)
receive dup2 server 1 BHBIHBIH 2,2,4,2130706433,*,4,2130706433,*