socket me 8001
host server 127.0.0.1 8000

# hello
send me server B 1

# Expecting hello response with count 0
receive me server 1 BH 2,0

# Send sync_start
send me server BBQ 11,253,0

# Receive delay request
receive me server 1 B 12

# Send delay response
send me server BBQ 13,253,1

# Note, that as new sync should be 254, we should not receive sync_start from this node

# Get time
send me server B 31

# Receive time
receive me server 1 BBQ 32,254,(0;10)

# Now we wait for desynchronization
sleep 31

# Get time
send me server B 31

# Receive time
receive me server 1 BBQ 32,255,*

# Synchronize with leader

# Send sync_start
send me server BBQ 11,0,100

# Receive delay request
receive me server 1 B 12

# Send delay response
send me server BBQ 13,0,1001

# Get time
send me server B 31

# Receive time
receive me server 1 BBQ 32,1,*

# Now we wait for desynchronization
sleep 31

# Get time
send me server B 31

# Receive time
receive me server 1 BBQ 32,255,*