socket me 8001
socket me2 8002
host server 127.0.0.1 8000

# Sync start from unknown peer
send me server BBQ 11,0,0 !
send me server BBQ 11,0,200 !
send me2 server BBQ 11,0,10 !

# Get to know
send me server B 3
receive me server 1 B 4

# Multiple syncs
send me server BBQ 11,0,0
# This line probably is right, because once we start sync, we should wait for it to end before next.
send me server BBQ 11,0,0 !

sleep 11

# Unknown peer again
send me2 server BBQ 11,0,10 !

# Unexpected messages from unknown peer
send me2 server BBQ 11,0,10 !
send me2 server BBQ 11,1,10 !
send me2 server B 12 !
send me2 server B 12 !
send me2 server BBQ 13,0,10 !
send me2 server BBQ 13,1,10 !

# Unexpected messages from known peer
send me server B 12 !
send me server B 12 !
send me server BBQ 13,0,10 !
send me server BBQ 13,1,10 !

# Valid peer but invalid synchronized
send me server BBQ 11,255,10 !

# Make leader
send me server BB 21,0
send me server BBQ 11,0,10 !
send me server BBQ 11,1,10 !
send me server BBQ 11,2,10 !
send me server BBQ 11,255,10 !