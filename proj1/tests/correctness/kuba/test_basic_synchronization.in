socket me 8001
socket other 8002
socket stranger 9000
host server 127.0.0.1 8000

# connect everybody
send me server B 1
receive me server 1 BH 2,0
send other server B 1
receive other server 0.1 BHBIH 2,1,4,2130706433,8001

# promote server to leader
send stranger server BB 21,0

# server should ignore delay requests
send me server B 12 !
send other server B 12 !

sleep 2

# server should send sync starts
receive me server 1 BBQ 11,0,*
receive other server 1 BBQ 11,0,*

sleep 10

# server should send sync starts
receive me server 1 BBQ 11,0,*
receive other server 1 BBQ 11,0,*

# Server should handle multiple delay requests
send me server B 12
send other server B 12

receive me server 0.1 BBQ 13,0,*
receive other server 0.1 BBQ 13,0,*

# Shouldn't allow multiple delay request for one sync start
send me server B 12 !
send other server B 12 !