socket me 8001
socket other 8002
socket stranger 9000
host server 127.0.0.1 8000

# connect everybody
send me server B 1
receive me server 0.1 BH 2,0
send other server B 1
receive other server 0.1 BHBIH 2,1,4,2130706433,8001

# send sync_start to the server
send me server BBQ 11,17,0

# receive delay request immediately
receive me server 0.1 B 12

# now the server is begining synchronization sequence with me, should ignore sync start from other, even if it's a better fit
send other server BBQ 11,0,0 !

# but after 5s should accept
sleep 6
send other server BBQ 11,0,0
receive other server 0.1 B 12