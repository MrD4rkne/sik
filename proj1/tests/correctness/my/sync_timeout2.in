socket me 8001
socket unknown 8002
host server 127.0.0.1 8000

# hello
send me server B 1

# Expecting hello response with count 0
receive me server 1 BH 2,0

# Synchronize with leader

# Send sync_start
send me server BBQ 11,0,100

# Receive delay request
receive me server 1 B 12

# Send delay response
send me server BBQ 13,0,1001

# Get time
send unknown server B 31

# Receive time
receive unknown server 1 BBQ 32,1,*

# Now we wait for desynchronization
sleep 31

# Get time
send unknown server B 31

# Receive time
receive unknown server 1 BBQ 32,255,*