socket me 8001

host server ::1 8000
connect me server 123 1

send me server HELLO 123\r\n

receive me server 0.2 COEFF \f[0;1] \f[1;1] \f[2;2]

send me server PUT 1 -4.5\r\n
receive me server 0.1 STATE **

send me server PUT 2 5\r\n
receive me server 0.1 STATE **

send me server PUT 0 1\r\n
receive me server 0.1 STATE \f[1;1] \f[-4.5;-4.5] \f[5;5]

receive me server 0.1 SCORING 123 \f[82.25;82.25]

close me server