socket me 8001

host server ::1 8000
connect me server 123 1

send me server HELLO 123\r\n

receive me server 1.1 COEFF *\r\n

send_invalid me server PUT 0 0..1\r\n
send_invalid me server PUT 0 0..2\r\n
receive me server 0.1 PENALTY *\r\n
send_invalid me server PUT 0 0..3\r\n
receive me server 0.1 PENALTY *\r\n
send_invalid me server PUT 0 0..4\r\n
receive me server 0.1 PENALTY *\r\n
send_invalid me server PUT 0 0..5\r\n
receive me server 0.1 PENALTY *\r\n
send_invalid me server PUT 0 0..6\r\n
receive me server 0.1 PENALTY *\r\n
send_invalid me server PUT 0 0..7\r\n
receive me server 0.1 PENALTY *\r\n
send_invalid me server PUT 0 0..8\r\n
receive me server 0.1 PENALTY *\r\n

sleep 1

receive me server 0.1 BAD_PUT 0 0..1\r\n0.1 BAD_PUT 0 0..2\r\n0.1 BAD_PUT 0 0..3\r\n0.1 BAD_PUT 0 0..4\r\n0.1 BAD_PUT 0 0..5\r\n0.1 BAD_PUT 0 0..6\r\n0.1 BAD_PUT 0 0..7\r\n0.1 BAD_PUT 0 0..8\r\n

close me server