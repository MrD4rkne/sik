socket me 8001

host server ::1 8000
connect me server 123 1

send me server HELLO 123\r\n

receive me server 1.1 COEFF *\r\n

send_invalid me server PUT 0 0-0\r\n
send_invalid me server PUT 0 0-0\r\n

receive me server 0.1 PENALTY 0 0-0\r\n
receive me server 1.1 BAD_PUT 0 0-0\r\n
receive me server 1.1 BAD_PUT 0 0-0\r\n

close me server