host client ::1 *

socket me 8000
listen me

# Client should connect to us
accept me client 5 UNKNOWN

receive me client 0.1 HELLO pl4yer

send me client COEFF 1 1\r\n

# Client should start sending puts
receive me client 1 PUT %f %f

# Now send a lot of bad responses

send_invalid me client BAD_PUT\r\n
send_invalid me client BAD_PUT \r\n
send_invalid me client BAD_PUT 1 \r\n
send_invalid me client BAD_PUT 1 1 \r\n
send_invalid me client BAD_PUT 1 1,0\r\n
send_invalid me client BAD_PUT 1,0 1\r\n
send_invalid me client BAD_PUT 1 1 3\r\n
send_invalid me client BAD_PUT 1.0000000 1\r\n
send_invalid me client BAD_PUT a 1\r\n
send_invalid me client BAD_PUT a a\r\n
send_invalid me client BAD_PUT 5 a\r\n
send_invalid me client BAD_PUT 0.0 1\r\n
send_invalid me client BAD_PUT 0,0 1\r\n
send_invalid me client BAD_PUT -1,0 1\r\n
send_invalid me client BAD_PUT -5,0 \r\n
send_invalid me client BAD_PUT 65536 0\r\n
# Max K is 1000
send_invalid me client BAD_PUT 10001 0\r\n
# . instead of .
send_invalid me client BAD_PUT 0 0,\r\n
send_invalid me client BAD_PUT 0 1,2\r\n
send_invalid me client BAD_PUT  \r\n
send_invalid me client BAD_PUT 0 \r\n
send_invalid me client BAD_PUT 0  \r\n
send_invalid me client BAD_PUT  0\r\n
send_invalid me client BAD_PUT   0\r\n

send_invalid me client PENALTY\r\n
send_invalid me client PENALTY \r\n
send_invalid me client PENALTY 1 \r\n
send_invalid me client PENALTY 1 1 \r\n
send_invalid me client PENALTY 1 1,0\r\n
send_invalid me client PENALTY 1,0 1\r\n
send_invalid me client PENALTY 1 1 3\r\n
send_invalid me client PENALTY 1.0000000 1\r\n
send_invalid me client PENALTY a 1\r\n
send_invalid me client PENALTY a a\r\n
send_invalid me client PENALTY 5 a\r\n
send_invalid me client PENALTY 0.0 1\r\n
send_invalid me client PENALTY 0,0 1\r\n
send_invalid me client PENALTY -1,0 1\r\n
send_invalid me client PENALTY -5,0\r\n
send_invalid me client PENALTY 65536,0\r\n
# Max K is 1000
send_invalid me client PENALTY 10001,0\r\n
# . instead of .
send_invalid me client PENALTY 0 0,\r\n
send_invalid me client PENALTY 0 1,2\r\n
send_invalid me client PENALTY  \r\n
send_invalid me client PENALTY 0 \r\n
send_invalid me client PENALTY 0  \r\n
send_invalid me client PENALTY  0\r\n
send_invalid me client PENALTY   0\r\n

# Should accept the valid responses
# Also, now it knows the value of K
send me client STATE 0 0 0.1111111 0.00\r\n

# Now should send PUT again
receive me client 1 PUT %f %f

# As we know the value of k, test if it is checked
send_invalid me client BAD_PUT -1 0\r\n
send_invalid me client BAD_PUT 5 0\r\n
send_invalid me client BAD_PUT 5. 0\r\n
send_invalid me client BAD_PUT 4. 0\r\n
send_invalid me client BAD_PUT 65535 0\r\n
send_invalid me client BAD_PUT 65536 0\r\n
send_invalid me client BAD_PUT 10001 0\r\n
send_invalid me client BAD_PUT 10002 0\r\n
send_invalid me client BAD_PUT -1 0\r\n
send_invalid me client BAD_PUT 5 0\r\n
send_invalid me client BAD_PUT 5. 0\r\n
send_invalid me client BAD_PUT 4. 0\r\n
send_invalid me client BAD_PUT 65535 0\r\n
send_invalid me client BAD_PUT 65536 0\r\n
send_invalid me client BAD_PUT 10001 0\r\n
send_invalid me client BAD_PUT 10002 0\r\n

send_invalid me client STATE 0 0 0 0 0\r\n
send_invalid me client STATE 0 0 0\r\n
send_invalid me client STATE 0, 0 0 0\r\n
send_invalid me client STATE 0 0, 0 0\r\n
send_invalid me client STATE 0 0 0, 0\r\n
send_invalid me client STATE 0 0 0 0,\r\n
send_invalid me client STATE 0   0 0\r\n
send_invalid me client STATE   0 0 0\r\n

sleep 2