socket me 8001

host server ::1 8000
connect me server UNKNOWN 1

# Now we send a BAD_PUT
# https://moodle.mimuw.edu.pl/mod/forum/discuss.php?d=11111#p23296
# Server should not send us a responses

send_invalid me server PUT 100001 0\r\n
expect_close me server 1

socket me2 8002
connect me2 server UNKNOWN 1
send_invalid me2 server HUFEHEHUHUFRHU\r\n
expect_close me2 server 1

