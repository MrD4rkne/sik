host client ::1 *

socket me 8000
listen me

# Client should connect to us
accept me client 5 UNKNOWN

receive me client 0.1 HELLO pl4y3r

# Note that message ends with ' '
send me client COEFF 1 

sleep 2

send me client 1.0000000 -1.0000000

sleep 2

send me client \r\n

# We take m = 3, optimal client should send responses
# as fast as possible

receive me client 0.1 PUT \f \f
send me client STATE 0 0 0\r\n

receive me client 0.1 PUT \f \f
send me client STATE 0 0 0\r\n

receive me client 0.1 PUT \f \f
send me client STATE 0 0 0\r\n

send me client SCORING pl4y3r 0\r\n

sleep 1