host client ::1 *

socket me 8000
listen me

# Client should connect to us
accept me client 5 pl4y3r

receive me client 0.1 HELLO pl4yer

send me client COEFF 1 1\r\n

# We take m = 3, optimal client should send responses
# as fast as possible

receive me client 0.1 PUT %f %f
send me client STATE 0 0 0\r\n

receive me client 0.1 PUT %f %f
send me client STATE 0 0 0\r\n

receive me client 0.1 PUT %f %f
send me client STATE 0 0 0\r\n

send me client SCORING pl4y3r 0

sleep 1